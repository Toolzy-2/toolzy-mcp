# Serveur MCP public (outils anonymes)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur d'autorisation (Better Auth) — outils connectés
# Base Postgres où l'AS range ses tables (schéma mcp_auth, search_path dans l'URL).
MCP_AUTH_DATABASE_URL=postgresql://user:password@host:5432/postgres?options=-c%20search_path%3Dmcp_auth
# 32 octets aléatoires minimum : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique de l'AS, ex. https://mcp.toolzy.io
BETTER_AUTH_URL=
# URL exacte du serveur MCP, audience des jetons, ex. https://mcp.toolzy.io/api/mcp
MCP_RESOURCE_URL=
# Clients MCP autorisés (hôtes de leurs documents CIMD), séparés par des virgules
MCP_ALLOWED_CLIENT_HOSTS=claude.ai,chatgpt.com

# Client OAuth confidentiel enregistré dans Supabase (Authentication > OAuth Apps)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
